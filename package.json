  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/google.maps": "^3.66.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.153.0"
  },
  "dependencies": {
    "@googlemaps/markerclusterer": "^2.6.2"
  },
