{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "martjakadri",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Enable once the laskesisse.ee zone is on Cloudflare (nameservers pointed to Cloudflare);
  // a deploy fails while the zone is missing. Wrangler then creates the DNS record and certificate.
  // "routes": [{ "pattern": "laskesisse.ee", "custom_domain": true }],

  // The Vite build outputs the frontend; the Worker only handles /api/*.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // No database_id: the first `wrangler deploy` creates the "martjakadri" D1 database,
  // and later commands find it by name.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "martjakadri",
      "migrations_dir": "migrations"
    }
  ],

  // 22:15 UTC = 00:15 Tallinn time in November (EET): purge listings of the day that just ended.
  "triggers": { "crons": ["15 22 * * *"] },

  // Settings live in the dashboard (Worker → Settings → Variables and Secrets), not here:
  // GOOGLE_MAPS_API_KEY, MAP_ID_MARDI, MAP_ID_KADRI, TURNSTILE_SITE_KEY (variables or secrets)
  // and TURNSTILE_SECRET_KEY (secret). keep_vars stops deploys from wiping dashboard variables.
  "keep_vars": true
}
